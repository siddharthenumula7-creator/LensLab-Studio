@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/

### Add photographer
POST {{baseUrl}}/api/photographers
Content-Type: application/json

{
  "name": "Asha Rao",
  "email": "asha2@example.com",
  "phone": "9876543210"
}

### Add camera
POST {{baseUrl}}/api/cameras
Content-Type: application/json

{
  "name": "Canon EOS 90D",
  "kind": "DSLR"
}

### Search cameras
GET {{baseUrl}}/api/cameras?kind=DSLR

### Rentals with joined names
GET {{baseUrl}}/api/rentals
